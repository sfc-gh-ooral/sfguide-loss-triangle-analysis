# Snowflake Connection
SNOWFLAKE_ACCOUNT=your_account_locator
SNOWFLAKE_USERNAME=your_username
SNOWFLAKE_DATABASE=LOSS_TRIANGLE_DEMO
SNOWFLAKE_SCHEMA=LOSS_TRIANGLES
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# Authentication — choose ONE method:

# Option 1: Key-pair authentication (recommended for production)
# Generate keys: openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out rsa_key.p8 -nocrypt
# Register:      ALTER USER your_username SET RSA_PUBLIC_KEY='<paste public key>';
# SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/rsa_key.p8

# Option 2: Password (development only)
# SNOWFLAKE_PASSWORD=your_password

# Option 3: OAuth / Personal Access Token
# SNOWFLAKE_TOKEN=your_token

# Option 4: External browser SSO (interactive sessions only)
# SNOWFLAKE_BROWSER_AUTH=true

# Cortex Agent — enables the AI chat page
# Run sql/cortex-agent.sql first, then uncomment:
# SNOWFLAKE_AGENT_NAME=LOSS_TRIANGLE_DEMO.LOSS_TRIANGLES.LOSS_TRIANGLE_AGENT
